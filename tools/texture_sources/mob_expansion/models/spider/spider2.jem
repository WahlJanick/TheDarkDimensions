{
	"credit": "Created by Mickey Joe Alpha - http://YouTube.com/@MushirMickeyJoe / with help from Ewan Howell",
	"textureSize": [128, 64],
	"texture": "textures/entity/spider/relatively_improved_scorpion.png",
	"models": [
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, -9, 3],
			"animations": [
				{
					"var.distance": "sqrt(pow(pos_x  -player_pos_x, 2) + pow(pos_y - player_pos_y, 2) + pow(pos_z - player_pos_z, 2))",
					"var.limit": 2,
					"varb.inrange": "var.distance < var.limit && is_aggressive",
					"var.counter": "clamp(if(varb.inrange, var.counter + 2 * frame_time, var.counter - 2 * frame_time), 0, 1)",
					"var.glowing_eyes": "max(if(is_aggressive, 10, var.glowing_eyes - 1 * frame_time), 0)",
					"head_chill.visible": "var.glowing_eyes == 0",
					"head_aggro.visible": "var.glowing_eyes > 0",
					"tail_start.rx": "torad(42.5) + (sin(time / 2) / 2 + torad(25)) * var.counter",
					"tail_whopper.rx": "torad(45) + -tail_start.rx/2",
					"tail_bobbing.ry": "head.ry/5",
					"tail_bobbing.rx": "leg1.ry/5",
					"scorpion_head.rx": "head.rx/2",
					"scorpion_head.ry": "head.ry/2",
					"arms.ry": "head.ry/3",
					"arms.rx": "head.rx/3",
					"health_bar.rx": "-player_rot_x",
					"health_bar.ry": "torad(180) - rot_y + player_rot_y",
					"var.health_bar": "max(if(is_hurt, 32, var.health_bar - 1 * frame_time), 0)",
					"health_bar.visible": "var.health_bar > 0 && death_time == 0"
				}
			]
		},
